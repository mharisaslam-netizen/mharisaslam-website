{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.dc.html", "destination": "/", "permanent": true },
    { "source": "/advisory.dc.html", "destination": "/work", "permanent": true },
    { "source": "/ai-lab.dc.html", "destination": "/ai-lab", "permanent": true },
    { "source": "/contact.dc.html", "destination": "/contact", "permanent": true },
    { "source": "/insights.dc.html", "destination": "/insights", "permanent": true },
    { "source": "/markets.dc.html", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/markets-qatar.dc.html", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/markets-oman.dc.html", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/markets-ksa.dc.html", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/markets-uae.dc.html", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/ventures.dc.html", "destination": "/ventures", "permanent": true },
    { "source": "/ai-commerce.dc.html", "destination": "/ai-commerce", "permanent": true },
    { "source": "/career-runway.dc.html", "destination": "/career-runway", "permanent": true },
    { "source": "/insight-agentic-commerce.dc.html", "destination": "/insights", "permanent": true },
    { "source": "/insight-delivery-layer.dc.html", "destination": "/insights", "permanent": true },
    { "source": "/insight-digital-commerce-strategy.dc.html", "destination": "/insights", "permanent": true },
    { "source": "/insight-ecommerce-profitability.dc.html", "destination": "/insights", "permanent": true },
    { "source": "/ventures-eir", "destination": "/ventures", "permanent": true },
    { "source": "/ventures-ai", "destination": "/ventures", "permanent": true },
    { "source": "/advisory", "destination": "/work", "permanent": true },
    { "source": "/retail-turnaround", "destination": "/work/retail-transformation-turnaround", "permanent": true },
    { "source": "/marketplace-strategy", "destination": "/work/commerce-marketplaces", "permanent": true },
    { "source": "/ecommerce-transformation", "destination": "/work/commerce-marketplaces", "permanent": true },
    { "source": "/markets", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/markets/qatar", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/markets/oman", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/markets/saudi-arabia", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/markets/uae", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/markets/ksa", "destination": "/work/growth-market-entry", "permanent": true },
    { "source": "/insights/australia-ecommerce-growth", "destination": "/insights", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }] }
  ]
}
